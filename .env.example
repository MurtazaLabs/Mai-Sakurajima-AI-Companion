# Mai AI environment template
# Copy to .env and fill in the values you need. Every variable is optional;
# the values below are the defaults the code falls back to.
# Never commit .env (it is git-ignored).

# ── API server ────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# Require bearer auth for every /api/* route except login/refresh/OIDC/SAML/health
API_REQUIRE_AUTH=false
# Static shared token; only used when API_REQUIRE_AUTH=true
API_AUTH_TOKEN=
# JWT signing secret (set a long random value when auth is enabled)
API_JWT_SECRET=
API_JWT_ACCESS_EXPIRE_MINUTES=15
API_JWT_REFRESH_EXPIRE_DAYS=7
API_CORS_ORIGINS=
API_TRUSTED_HOSTS=127.0.0.1,localhost
API_SSL_CERTFILE=
API_SSL_KEYFILE=
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_CHAT=60
API_RATE_LIMIT_HEALTH=300
API_RATE_LIMIT_AUTH=20
API_RATE_LIMIT_GENERAL=120
API_RATE_LIMIT_INGEST=10

# ── LLM ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=qwen2.5:3b-instruct-q4_k_m
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.85
LLM_MAX_CONTEXT=4096
LLM_TIMEOUT=120
LLM_RETRY_COUNT=3
LLM_STREAM=true
LLM_STOP_TOKENS=
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
LLAMACPP_BASE_URL=http://127.0.0.1:8082
LLAMACPP_MODEL=spark
LLAMACPP_API_KEY=

# ── Voice ─────────────────────────────────────────────────────────────────
VOICE_STACK=local
STT_BACKEND=kyutai
# Defaults to "<repo>/kyutai STT/stt-1b-en_fr-trfs" when unset.
# KYUTAI_STT_DIR=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=HY4HX0IWY87Q5uoIYH4v
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_TIMEOUT=60

# ── Memory / database ─────────────────────────────────────────────────────
# Defaults to "<home>/MaiMemory" when unset.
# MAI_OBSIDIAN_VAULT=
MAI_DB_AUTO_MIGRATE=
DATABASE_URL=
POSTGRES_DSN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Redis (horizontal scaling; optional) ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DECODE_RESPONSES=true
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_SOCKET_TIMEOUT=5.0

# ── Observability ─────────────────────────────────────────────────────────
DEPLOYMENT_ENV=development
MAI_VERSION=2.0.0
MAI_OTEL_ENABLED=
MAI_OTEL_ENDPOINT=
MAI_OTEL_SAMPLE_RATE=0.1

# ── Partner (calendar + read-only mail) ───────────────────────────────────
# Defaults to "<repo>/data/calendar.ics" when unset.
# MAI_CALENDAR_ICS=
MAI_MAIL_IMAP_HOST=
MAI_MAIL_IMAP_PORT=993
MAI_MAIL_IMAP_USER=
MAI_MAIL_IMAP_PASSWORD=
MAI_MAIL_IMAP_FOLDER=INBOX
MAI_MAIL_IMAP_SSL=1
MAI_MAIL_IMAP_TIMEOUT=15
MAI_PARTNER_QUIET=

# ── Self-awareness ────────────────────────────────────────────────────────
# Defaults to "<repo>/logs/mai.log" when unset.
# MAI_SELF_LOG=
MAI_SELF_MAX_MODULES=4000
MAI_SELF_ERROR_THRESHOLD=3

# ── Research (T4) ─────────────────────────────────────────────────────────
# Artifacts default to "<vault>/research"; leave commented unless overriding.
# MAI_RESEARCH_ARTIFACTS=
MAI_RESEARCH_MAX_SOURCES=6
MAI_RESEARCH_MAX_CHARS=8000
MAI_RESEARCH_TIMEOUT=15
MAI_RESEARCH_MAX_QUEUE=8
MAI_RESEARCH_HISTORY=100
MAI_RESEARCH_SEARCH=true
MAI_RESEARCH_SEARCH_URL=https://html.duckduckgo.com/html/
MAI_RESEARCH_SEARCH_RESULTS=5
MAI_RESEARCH_AUTONOMOUS=true
MAI_RESEARCH_TICK=300
# auto | urllib | playwright (playwright needs: pip install playwright && playwright install chromium)
MAI_RESEARCH_BROWSER=auto

# ── Plugins / integrations ────────────────────────────────────────────────
MAI_ALLOW_UNSIGNED_PLUGINS=
MAI_PLUGIN_ALLOW_EVAL=
MAI_SCRAPER_ALLOW_PRIVATE=
OPENWEATHER_API_KEY=
DISCORD_TOKEN=
DISCORD_PREFIX=!
MAI_API_URL=http://127.0.0.1:8000
MAI_API_TOKEN=

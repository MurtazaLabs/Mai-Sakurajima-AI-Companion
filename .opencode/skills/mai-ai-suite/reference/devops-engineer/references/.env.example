# Default environment configuration for Mai AI
# Copy to .env and fill in your values
# NEVER commit .env with real secrets to version control

# Application
APP_NAME=Mai AI
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0

# API Keys (set these via CI secrets or vault in production)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Database / Storage
DATA_DIR=./data
CACHE_DIR=./cache
LOGS_DIR=./logs
KNOWLEDGE_DIR=./knowledge_docs

# Model Configuration
LLM_PROVIDER=openrouter
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=mistralai/mixtral-8x7b-instruct

# Memory
MEMORY_VAULT_PATH=./data/memory_vault
VECTOR_STORE_PATH=./data/vector_store
MAX_MEMORY_ITEMS=10000

# Voice
VOICE_ENABLED=true
STT_MODEL=base
TTS_ENGINE=kokoro

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Feature Flags
KNOWLEDGE_BASE_ENABLED=true
PLUGIN_SYSTEM_ENABLED=false
DREAM_ENGINE_ENABLED=true
